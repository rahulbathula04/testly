{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/locations/madhapur",
      "destination": "/locations/hyderabad",
      "permanent": true
    },
    {
      "source": "/locations/madhapur/",
      "destination": "/locations/hyderabad",
      "permanent": true
    },
    {
      "source": "/locations/delhi",
      "destination": "/locations/delhi-ncr",
      "permanent": true
    },
    {
      "source": "/locations/delhi/",
      "destination": "/locations/delhi-ncr",
      "permanent": true
    }
  ]
}
